    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="assets\app.ico" />
    <Resource Include="..\..\assets\app-icon.png" Link="assets\app-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GlassFolders.App\GlassFolders.App.csproj" />
    <ProjectReference Include="..\..\src\GlassFolders.Core\GlassFolders.Core.csproj" />
    <ProjectReference Include="..\..\src\GlassFolders.Native\GlassFolders.Native.csproj" />
  </ItemGroup>
</Project>
