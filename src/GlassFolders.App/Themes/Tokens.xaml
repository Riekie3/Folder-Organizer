<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Radii -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">16</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">24</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">28</CornerRadius>

    <!-- Typography -->
    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif</FontFamily>

    <!-- Solid Colors -->
    <Color x:Key="ColorTextPrimary">#FFFFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#CCFFFFFF</Color>
    <Color x:Key="ColorTextMuted">#80FFFFFF</Color>
    <Color x:Key="ColorAccentBlue">#3B6FE0</Color>
    <Color x:Key="ColorAccentPurple">#8B5CF6</Color>
    <Color x:Key="ColorAccentRed">#EF4444</Color>
    <Color x:Key="ColorAccentGreen">#10B981</Color>
    <Color x:Key="ColorAccentAmber">#F59E0B</Color>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccentBlue}"/>

    <!-- Glass Surface Brushes -->
    <SolidColorBrush x:Key="BrushGlassSurface" Color="#D9162444"/>
    <SolidColorBrush x:Key="BrushGlassBorder" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="BrushGlassBorderBright" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="BrushGlassHover" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="BrushGlassSelected" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="BrushGlassInput" Color="#26FFFFFF"/>

    <!-- Gradient Glass Brushes -->
    <LinearGradientBrush x:Key="BrushPopupBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E61A2B52" Offset="0"/>
        <GradientStop Color="#E6101B36" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushFolderPlate" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTopGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Drop Shadows -->
    <DropShadowEffect x:Key="ShadowText" BlurRadius="4" ShadowDepth="1" Opacity="0.6" Color="Black"/>
    <DropShadowEffect x:Key="ShadowPopup" BlurRadius="32" ShadowDepth="8" Opacity="0.45" Color="#0A1028"/>
    <DropShadowEffect x:Key="ShadowTile" BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="#1E46C8"/>

    <!-- Durations -->
    <Duration x:Key="DurationFast">0:0:0.120</Duration>
    <Duration x:Key="DurationNormal">0:0:0.200</Duration>
    <Duration x:Key="DurationSlow">0:0:0.320</Duration>

</ResourceDictionary>
