<UserControl x:Class="GlassFolders.App.Poc.FolderTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="104" Height="112" Background="Transparent" Cursor="Hand"
             AllowDrop="True">
    <Grid>
        <!-- Hover / selected plate (frosted tile from reference image 1) -->
        <Border x:Name="Plate" CornerRadius="16" BorderThickness="1" Opacity="0"
                BorderBrush="#B3FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                    <GradientStop Color="#26FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="#1E46C8"/>
            </Border.Effect>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="60" Height="60">
                <Viewbox Width="60" Height="60">
                    <Canvas Width="64" Height="64">
                        <!-- Back folder plate -->
                        <Path x:Name="BackPlate" Data="M6,14 A5,5 0 0 1 11,9 L24,9 A3,3 0 0 1 26.6,10.5 L28.2,13.4 A3,3 0 0 0 30.8,15 L53,15 A5,5 0 0 1 58,20 L58,51 A5,5 0 0 1 53,56 L11,56 A5,5 0 0 1 6,51 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="StopA" Color="#7FB2FF" Offset="0"/>
                                    <GradientStop x:Name="StopB" Color="#5B5CF2" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Translucent frosted front flap -->
                        <Path Data="M12,26 A4,4 0 0 1 15.9,22.8 L57,22.8 A3,3 0 0 1 59.9,26.5 L54,51 A5,5 0 0 1 49.2,54.8 L9,54.8 A3,3 0 0 1 6.1,51.1 Z"
                              Stroke="#E6FFFFFF" StrokeThickness="0.8">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8CFFFFFF" Offset="0"/>
                                    <GradientStop Color="#73FFFFFF" Offset="0.85"/>
                                    <GradientStop Color="#D9FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Category Glyph -->
                        <Path x:Name="GlyphPath" Fill="#F0FFFFFF"
                              Data="M24,28 A2,2 0 0 1 26,26 L38,26 A2,2 0 0 1 40,28 L40,42 A2,2 0 0 1 38,44 L26,44 A2,2 0 0 1 24,42 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.4" Color="Black"/>
                            </Path.Effect>
                        </Path>
                    </Canvas>
                </Viewbox>

                <!-- Count Badge -->
                <Border x:Name="CountBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,2,2,0" Background="#E63B6FE0" CornerRadius="8" Padding="5,1"
                        BorderBrush="#80FFFFFF" BorderThickness="0.8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtBadgeCount" Text="0" FontSize="9" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock x:Name="Label" Text="Folder" Foreground="White" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"
                       HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="96">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
