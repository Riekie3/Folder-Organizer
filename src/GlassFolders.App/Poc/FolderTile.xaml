<UserControl x:Class="GlassFolders.App.Poc.FolderTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GlassFolders.App.UI"
             Background="Transparent" Cursor="Hand" AllowDrop="True">
    <!-- Sizes come from FolderTileMetrics in code. The window is the plate plus room for its glow. -->
    <Grid x:Name="Root">

        <!-- Frosted plate shown on hover and while the folder is open (reference 1, "Work"). -->
        <Grid x:Name="Plate" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Glow, as blurred rims so it works over any fill: a wide soft blue halo outside,
                 and a brighter cyan line along the edge. -->
            <Border x:Name="PlateHalo" CornerRadius="24" BorderThickness="6" Margin="-5" BorderBrush="#B34DA8FF">
                <Border.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian"/>
                </Border.Effect>
            </Border>
            <Border x:Name="PlateGlow" CornerRadius="21" BorderThickness="3" Margin="-1.5" BorderBrush="#8FE3FF">
                <Border.Effect>
                    <BlurEffect Radius="6" KernelType="Gaussian"/>
                </Border.Effect>
            </Border>
            <!-- The wallpaper under the plate, blurred. Empty when the wallpaper can't be read. -->
            <Border x:Name="PlateBackdrop" CornerRadius="20"/>
            <Border x:Name="PlateVeil" CornerRadius="20">
                <Border.Background>
                    <!-- Light cyan glass, as sampled from the reference plate. -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#70C2EBFF" Offset="0"/>
                        <GradientStop Color="#4DBFE9FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="PlateRim" CornerRadius="20" BorderThickness="1.5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2E6FBFF" Offset="0"/>
                        <GradientStop Color="#B3C2F4FE" Offset="0.5"/>
                        <GradientStop Color="#F2E0FAFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>

        <!-- The folder and its label. An almost invisible fill makes the whole box respond to the mouse,
             as a desktop icon's cell does, without drawing anything. -->
        <Grid x:Name="Box" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#01000000">
            <StackPanel x:Name="BoxStack" HorizontalAlignment="Center">
                <Grid x:Name="ArtHost" HorizontalAlignment="Center">
                    <ui:FolderIconView x:Name="Art"/>
                    <Border x:Name="CountBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-3,-6,0" Background="#E62F7FE8" CornerRadius="9" Padding="6,1"
                            BorderBrush="#99FFFFFF" BorderThickness="1" Visibility="Collapsed">
                        <TextBlock x:Name="TxtBadgeCount" Text="0" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- White text with a tight dark outline, as the reference draws it; on a light plate the
                     ink turns dark with a soft light edge. A faint shadow lifts it off busy wallpapers. -->
                <ui:OutlinedText x:Name="Label" Text="Folder" HorizontalAlignment="Center">
                    <ui:OutlinedText.Effect>
                        <DropShadowEffect x:Name="LabelShadow" BlurRadius="3" ShadowDepth="1" Direction="270"
                                          Opacity="0.35" Color="Black"/>
                    </ui:OutlinedText.Effect>
                </ui:OutlinedText>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
