<ui:GlassWindow x:Class="GlassFolders.App.UI.FolderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GlassFolders.App.UI"
        SizeToContent="WidthAndHeight" Title="Edit Folder">

    <ui:GlassCard x:Name="Card" Margin="40" Width="560">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <TextBlock x:Name="TxtHeader" Text="Edit Folder" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeText}" FontFamily="{StaticResource FontDisplay}"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource GlassIconButton}" Click="OnBtnCancelClicked" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource ChromeText}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Form -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Folder name" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtName" Margin="0,0,0,16" MaxLength="40" TextChanged="OnFormChanged"/>

                    <TextBlock Text="Icon" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="GlyphsPanel" Margin="0,0,0,10"/>

                    <TextBlock Text="Colour" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="ColorPresetsPanel" Margin="0,0,0,8"/>

                    <TextBlock Text="Style" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource SegmentedBar}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioSolid" Content="Solid" GroupName="Style" Style="{StaticResource SegmentedItem}" Checked="OnStyleChecked"/>
                            <RadioButton x:Name="RadioGlass" Content="Glass" GroupName="Style" Style="{StaticResource SegmentedItem}" Checked="OnStyleChecked"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Size" Style="{StaticResource HintText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource SegmentedBar}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioSmall" Content="Small" GroupName="Size" Style="{StaticResource SegmentedItem}" Checked="OnSizeChecked"/>
                            <RadioButton x:Name="RadioMedium" Content="Medium" GroupName="Size" Style="{StaticResource SegmentedItem}" Checked="OnSizeChecked"/>
                            <RadioButton x:Name="RadioLarge" Content="Large" GroupName="Size" Style="{StaticResource SegmentedItem}" Checked="OnSizeChecked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Live preview: the same art the desktop draws -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" VerticalAlignment="Top" Padding="12,14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Preview" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Grid Width="104" Height="88">
                            <ui:FolderIconView x:Name="PreviewArt" Width="64" Height="54"/>
                        </Grid>
                        <TextBlock x:Name="PreviewLabel" Text="Folder" Foreground="{DynamicResource ChromeText}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="116"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" MinWidth="92" Margin="0,0,10,0" Style="{StaticResource GlassButton}" IsCancel="True" Click="OnBtnCancelClicked"/>
                <Button Content="Save" MinWidth="92" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnBtnSaveClicked"/>
            </StackPanel>
        </Grid>
    </ui:GlassCard>
</ui:GlassWindow>
