<Window x:Class="GlassFolders.App.UI.FolderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" Title="Edit Folder">

    <Border Width="480" Margin="16" CornerRadius="24" BorderThickness="1"
            BorderBrush="{StaticResource BrushGlassBorderBright}"
            Background="{StaticResource BrushPopupBackground}"
            Effect="{StaticResource ShadowPopup}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TxtHeader" Text="Edit Folder" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontDisplay}"/>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource GlassIconButton}" Click="OnBtnCancelClicked"/>
            </Grid>

            <!-- Content Area: Form + Live Tile Preview -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Form Controls -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <!-- Folder Name -->
                    <TextBlock Text="Folder Name" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource GlassTextBox}" Margin="0,0,0,16"
                             TextChanged="OnFormChanged"/>

                    <!-- Category Glyph -->
                    <TextBlock Text="Category Icon" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="GlyphsPanel" Margin="0,0,0,16"/>

                    <!-- Color Theme Presets -->
                    <TextBlock Text="Color Theme" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="ColorPresetsPanel" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Right Column: Live Vector Preview -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" VerticalAlignment="Top" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Preview" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Vector Tile Preview -->
                        <Viewbox Width="70" Height="70">
                            <Canvas Width="64" Height="64">
                                <Path x:Name="PreviewBackPlate" Data="M6,14 A5,5 0 0 1 11,9 L24,9 A3,3 0 0 1 26.6,10.5 L28.2,13.4 A3,3 0 0 0 30.8,15 L53,15 A5,5 0 0 1 58,20 L58,51 A5,5 0 0 1 53,56 L11,56 A5,5 0 0 1 6,51 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="PreviewStopA" Color="#7FB2FF" Offset="0"/>
                                            <GradientStop x:Name="PreviewStopB" Color="#5B5CF2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <Path Data="M12,26 A4,4 0 0 1 15.9,22.8 L57,22.8 A3,3 0 0 1 59.9,26.5 L54,51 A5,5 0 0 1 49.2,54.8 L9,54.8 A3,3 0 0 1 6.1,51.1 Z"
                                      Stroke="#E6FFFFFF" StrokeThickness="0.8">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#8CFFFFFF" Offset="0"/>
                                            <GradientStop Color="#73FFFFFF" Offset="0.85"/>
                                            <GradientStop Color="#D9FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <Path x:Name="PreviewGlyph" Fill="#F0FFFFFF" Data="{StaticResource GlyphFolder}"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock x:Name="PreviewLabel" Text="Folder" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer: Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource GlassButton}" Click="OnBtnCancelClicked"/>
                <Button Content="Save" Width="90" Height="32"
                        Style="{StaticResource GlassButton}" Background="{StaticResource BrushAccent}"
                        Click="OnBtnSaveClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
