<ui:GlassWindow x:Class="GlassFolders.App.UI.GlassMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GlassFolders.App.UI"
        SizeToContent="WidthAndHeight" Title="GlassFolders">

    <ui:GlassCard x:Name="Card" Margin="40" Width="460">
        <StackPanel Margin="28,26,28,24">
            <DockPanel LastChildFill="True">
                <Border x:Name="IconBadge" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                        Background="{DynamicResource ChromeRow}" VerticalAlignment="Top">
                    <Path x:Name="KindIcon" Width="22" Height="22" Stretch="Uniform" StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource FontDisplay}"
                           Foreground="{DynamicResource ChromeText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <TextBlock x:Name="TxtMessage" Style="{StaticResource BodyText}" FontSize="14" TextWrapping="Wrap"/>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GlassButton}" MinWidth="88" Margin="0,0,10,0" Click="OnCancelClicked"/>
                <Button x:Name="BtnNo" Content="No" Style="{StaticResource GlassButton}" MinWidth="88" Margin="0,0,10,0" Click="OnNoClicked"/>
                <Button x:Name="BtnYes" Content="Yes" Style="{StaticResource AccentButton}" MinWidth="88" Click="OnYesClicked"/>
            </StackPanel>
        </StackPanel>
    </ui:GlassCard>
</ui:GlassWindow>
