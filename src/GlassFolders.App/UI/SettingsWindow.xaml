<ui:GlassWindow x:Class="GlassFolders.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GlassFolders.App.UI"
        ShowInTaskbar="True" Width="900" Height="660"
        Title="GlassFolders Settings" Icon="pack://application:,,,/GlassFolders;component/assets/app.ico">

    <ui:GlassWindow.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource ChromeDivider}"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style x:Key="LineIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource ChromeText}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </ui:GlassWindow.Resources>

    <ui:GlassCard x:Name="Card" Margin="40" Width="820" Height="580">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource ChromeSidebar}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ChromeDivider}" MouseLeftButtonDown="OnDragRegionMouseDown">
                <Grid Margin="16,24,16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="6,0,0,22" Orientation="Horizontal">
                        <Image Source="pack://application:,,,/GlassFolders;component/assets/app-icon.png" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GlassFolders" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeText}" FontFamily="{StaticResource FontDisplay}"/>
                            <TextBlock Text="Desktop Organizer" FontSize="11.5" Foreground="{DynamicResource ChromeTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavGeneral" Content="General" Style="{StaticResource NavItem}" Tag="{StaticResource IconGeneral}"
                                     GroupName="Nav" IsChecked="True" Checked="OnNavGeneralClicked"/>
                        <RadioButton x:Name="NavAppearance" Content="Appearance" Style="{StaticResource NavItem}" Tag="{StaticResource IconAppearance}"
                                     GroupName="Nav" Checked="OnNavAppearanceClicked"/>
                        <RadioButton x:Name="NavLayout" Content="Desktop Layout" Style="{StaticResource NavItem}" Tag="{StaticResource IconLayout}"
                                     GroupName="Nav" Checked="OnNavLayoutClicked"/>
                        <RadioButton x:Name="NavAnimation" Content="Animations" Style="{StaticResource NavItem}" Tag="{StaticResource IconAnimation}"
                                     GroupName="Nav" Checked="OnNavAnimationClicked"/>
                        <RadioButton x:Name="NavRecovery" Content="Explorer Recovery" Style="{StaticResource NavItem}" Tag="{StaticResource IconRecovery}"
                                     GroupName="Nav" Checked="OnNavRecoveryClicked"/>
                        <RadioButton x:Name="NavBackup" Content="Backup &amp; Restore" Style="{StaticResource NavItem}" Tag="{StaticResource IconBackup}"
                                     GroupName="Nav" Checked="OnNavBackupClicked"/>
                        <RadioButton x:Name="NavAbout" Content="About" Style="{StaticResource NavItem}" Tag="{StaticResource IconAbout}"
                                     GroupName="Nav" Checked="OnNavAboutClicked"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtSidebarVersion" Text="v" FontSize="11" Foreground="{DynamicResource ChromeTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="rie-sources.com" FontSize="11.5" Foreground="{DynamicResource ChromeLink}" HorizontalAlignment="Center"
                                   Margin="0,3,0,0" Cursor="Hand" MouseLeftButtonDown="OnBrandUrlClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="30,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="OnDragRegionMouseDown">
                    <TextBlock x:Name="TxtPageTitle" Text="General" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChromeText}" FontFamily="{StaticResource FontDisplay}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GlassIconButton}" Click="OnBtnCloseClicked" ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClose}" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel>

                        <!-- GENERAL -->
                        <StackPanel x:Name="PageGeneral" Visibility="Visible">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Startup and behaviour" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ChkStartWithWindows" Content="Start GlassFolders when Windows starts"
                                              Checked="OnStartupCheckChanged" Unchecked="OnStartupCheckChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkCheckMissing" Content="Show a warning badge on shortcuts whose target is missing"
                                              IsChecked="True" Checked="OnDesktopOptionChanged" Unchecked="OnDesktopOptionChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Desktop folders" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ChkSnapToGrid" Content="Snap folders to the desktop icon grid when dragging"
                                              IsChecked="True" Checked="OnDesktopOptionChanged" Unchecked="OnDesktopOptionChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkShowItemCount" Content="Show how many items each folder holds"
                                              Checked="OnDesktopOptionChanged" Unchecked="OnDesktopOptionChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource CardTitle}"/>
                                    <Border Style="{StaticResource SegmentedBar}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbThemeSystem" Content="Follow Windows" GroupName="Theme" Style="{StaticResource SegmentedItem}" Checked="OnThemeChecked"/>
                                            <RadioButton x:Name="RbThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource SegmentedItem}" Checked="OnThemeChecked"/>
                                            <RadioButton x:Name="RbThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource SegmentedItem}" Checked="OnThemeChecked"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                               Text="Sets the colours of Settings, menus and dialogs. The folder popup keeps its blue glass in both."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Glass" Style="{StaticResource CardTitle}"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Transparency" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderTransparency" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnAppearanceSliderChanged"/>
                                        <TextBlock x:Name="TxtTransparencyVal" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Blur" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderBlur" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnAppearanceSliderChanged"/>
                                        <TextBlock x:Name="TxtBlurVal" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Border" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderBorder" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnAppearanceSliderChanged"/>
                                        <TextBlock x:Name="TxtBorderVal" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Shadow" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderShadow" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnAppearanceSliderChanged"/>
                                        <TextBlock x:Name="TxtShadowVal" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Corner radius" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderCorner" Grid.Column="1" Minimum="16" Maximum="48" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAppearanceSliderChanged"/>
                                        <TextBlock x:Name="TxtCornerVal" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,10"
                                               Text="Changes show here at once and apply to the folder popup the next time it opens. If Windows has transparency effects off, or high contrast is on, the glass becomes a solid panel."/>
                                    <Button Content="Reset glass settings" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="OnBtnResetAppearanceClicked"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Folder popup" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="App icon size" Style="{StaticResource RowLabel}" Margin="0,2,0,8"/>
                                    <Border Style="{StaticResource SegmentedBar}" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbIconSmall" Content="Small" GroupName="IconSize" Style="{StaticResource SegmentedItem}" Checked="OnIconSizeChecked"/>
                                            <RadioButton x:Name="RbIconMedium" Content="Medium" GroupName="IconSize" Style="{StaticResource SegmentedItem}" Checked="OnIconSizeChecked"/>
                                            <RadioButton x:Name="RbIconLarge" Content="Large" GroupName="IconSize" Style="{StaticResource SegmentedItem}" Checked="OnIconSizeChecked"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Columns" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderColumns" Grid.Column="1" Minimum="3" Maximum="6" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnColumnsSliderChanged"/>
                                        <TextBlock x:Name="TxtColumnsVal" Grid.Column="2" Style="{StaticResource ValueText}" Text="4"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rows" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderRows" Grid.Column="1" Minimum="2" Maximum="5" Value="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnRowsSliderChanged"/>
                                        <TextBlock x:Name="TxtRowsVal" Grid.Column="2" Style="{StaticResource ValueText}" Text="2"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- DESKTOP LAYOUT -->
                        <StackPanel x:Name="PageLayout" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Connected displays" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                               Text="Each folder stays on its own display. If a display is unplugged, its folders move to the main display for now and go back when it returns."/>
                                    <ItemsControl x:Name="MonitorsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ChromeRow}" CornerRadius="12" Padding="14,10" Margin="0,0,0,6">
                                                    <DockPanel LastChildFill="True">
                                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconLayout}" Width="20" Height="20" Margin="0,0,12,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}"/>
                                                            <TextBlock Text="{Binding WorkArea, StringFormat='Work area: {0}'}" FontSize="12" Foreground="{DynamicResource ChromeTextMuted}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <TextBlock Text="Desktop folders" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                        <Button Content="New folder" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="16,6" Click="OnBtnNewFolderClicked"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="FoldersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ChromeRow}" CornerRadius="12" Padding="14,10" Margin="0,0,0,6">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} items'}" Foreground="{DynamicResource ChromeTextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ANIMATIONS -->
                        <StackPanel x:Name="PageAnimation" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Animation controls" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ChkGlobalAnim" Content="Use animations"
                                              Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkFollowWindowsAnim" Content="Follow the Windows &quot;Animation effects&quot; setting"
                                              Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Speed" Style="{StaticResource RowLabel}"/>
                                        <Slider x:Name="SliderAnimSpeed" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                ValueChanged="OnAnimSpeedSliderChanged"/>
                                        <TextBlock x:Name="TxtAnimSpeedVal" Grid.Column="2" Style="{StaticResource ValueText}" Text="1.0x"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" x:Name="CardAnimCategories">
                                <StackPanel>
                                    <TextBlock Text="What animates" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ChkAnimOpenClose" Content="Folder popup opening and closing" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimTileHover" Content="Desktop folder hover glow" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimItemPress" Content="Press feedback on items" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimPageTrans" Content="Sliding between popup pages" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimWindowTrans" Content="Popup growing and shrinking" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimDragGhost" Content="Dragging a folder" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimShimmer" Content="A soft glint when the popup opens (plays once)" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Rectangle Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="ChkAnimSettingsNav" Content="Moving between Settings pages" Checked="OnAnimationSettingChanged" Unchecked="OnAnimationSettingChanged"/>
                                    <Button Content="Reset animation settings" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Click="OnBtnResetAnimDefaultsClicked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- EXPLORER RECOVERY -->
                        <StackPanel x:Name="PageRecovery" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Explorer recovery" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                                               Text="GlassFolders watches Explorer for crashes, restarts and wake-ups, and puts the desktop folders back by itself."/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="State" Style="{StaticResource RowLabel}" Foreground="{DynamicResource ChromeTextMuted}"/>
                                        <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="10,2" x:Name="BadgeRecoveryState"
                                                Background="{DynamicResource ChromeRow}">
                                            <TextBlock x:Name="TxtRecoveryState" Text="Healthy" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource ChromeOk}"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Text="Last event" Style="{StaticResource RowLabel}" Foreground="{DynamicResource ChromeTextMuted}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRecoveryLastEvent" Text="Initialized" Style="{StaticResource RowLabel}" Foreground="{DynamicResource ChromeTextSecondary}"/>

                                        <TextBlock Grid.Row="2" Text="Reattach count" Style="{StaticResource RowLabel}" Foreground="{DynamicResource ChromeTextMuted}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtReattachCount" Text="0" Style="{StaticResource RowLabel}" Foreground="{DynamicResource ChromeTextSecondary}"/>
                                    </Grid>

                                    <Button x:Name="BtnRecoverNow" Content="Recover now" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="OnBtnRecoverNowClicked"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                               Text="Logs roll over at 1 MB, and the five newest are kept in your local app data. A lower level writes more."/>
                                    <TextBlock Text="Log level" Style="{StaticResource RowLabel}" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource SegmentedBar}" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbLogError" Content="Errors" GroupName="LogLevel" Style="{StaticResource SegmentedItem}" Checked="OnLogLevelChecked"/>
                                            <RadioButton x:Name="RbLogWarning" Content="Warnings" GroupName="LogLevel" Style="{StaticResource SegmentedItem}" Checked="OnLogLevelChecked"/>
                                            <RadioButton x:Name="RbLogInfo" Content="Info" GroupName="LogLevel" Style="{StaticResource SegmentedItem}" Checked="OnLogLevelChecked"/>
                                            <RadioButton x:Name="RbLogDebug" Content="Debug" GroupName="LogLevel" Style="{StaticResource SegmentedItem}" Checked="OnLogLevelChecked"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Open logs folder" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="OnBtnOpenLogsClicked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- BACKUP & RESTORE -->
                        <StackPanel x:Name="PageBackup" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Export a backup" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                               Text="Saves your folders, layout, settings and icon cache in one ZIP that you can move to another PC."/>
                                    <Button Content="Export backup…" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="OnBtnExportBackupClicked"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Restore a backup" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                               Text="Choose a backup ZIP, then replace your setup or merge its folders into it. A safety backup of your current setup is made first."/>
                                    <Button Content="Restore from backup…" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="OnBtnImportBackupClicked"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Start over" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                               Text="Puts folders and settings back to the defaults. Your files and applications are never deleted."/>
                                    <Button Content="Reset to defaults…" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="OnBtnResetDefaultsClicked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ABOUT -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/GlassFolders;component/assets/app-icon.png" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <TextBlock Text="GlassFolders" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ChromeText}" FontFamily="{StaticResource FontDisplay}"/>
                                    <TextBlock x:Name="TxtAboutVersion" Text="Version" FontSize="13" Foreground="{DynamicResource ChromeLink}" Margin="0,2,0,12"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,16"
                                               Text="Phone-style app folders on your real Windows 11 desktop, with a Liquid Glass popup."/>

                                    <Border Background="{DynamicResource ChromeRow}" BorderBrush="{DynamicResource ChromeCardBorder}" CornerRadius="14" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconGlobe}" Width="24" Height="24" Margin="0,0,14,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Developed by Rie-Sources" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}"/>
                                                <TextBlock Margin="0,2,0,0">
                                                    <Hyperlink NavigateUri="https://rie-sources.com/" RequestNavigate="OnHyperlinkRequestNavigate" Foreground="{DynamicResource ChromeLink}">
                                                        <Run Text="https://rie-sources.com/"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                               Text="Built with .NET 10 and WPF. The glass is a one-time snapshot of the screen behind each window, blurred and tinted. Per-monitor DPI aware."/>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,16" Text="Made for Windows 11."/>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Copyright © 2026 Rie-Sources (https://rie-sources.com/). Released under the MIT License."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ui:GlassCard>
</ui:GlassWindow>
