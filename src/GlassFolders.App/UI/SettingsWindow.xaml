<Window x:Class="GlassFolders.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="CanResize" Width="820" Height="580"
        MinHeight="500" MinWidth="680" WindowStartupLocation="CenterScreen"
        Title="GlassFolders Settings">

    <Border Margin="16" CornerRadius="28" BorderThickness="1"
            BorderBrush="{StaticResource BrushGlassBorderBright}"
            Background="{StaticResource BrushPopupBackground}"
            Effect="{StaticResource ShadowPopup}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Glass Sidebar Navigation -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#26FFFFFF"
                    Background="#14FFFFFF" CornerRadius="28,0,0,28">
                <Grid Margin="18,24,18,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,24">
                        <TextBlock Text="GlassFolders" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontDisplay}"/>
                        <TextBlock Text="Desktop Organizer" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavGeneral" Content="General" Height="38" Margin="0,0,0,6"
                                HorizontalContentAlignment="Left" Padding="14,0" Style="{StaticResource GlassButton}"
                                Click="OnNavGeneralClicked"/>
                        <Button x:Name="NavAppearance" Content="Appearance" Height="38" Margin="0,0,0,6"
                                HorizontalContentAlignment="Left" Padding="14,0" Style="{StaticResource GlassButton}"
                                Click="OnNavAppearanceClicked"/>
                        <Button x:Name="NavLayout" Content="Desktop Layout" Height="38" Margin="0,0,0,6"
                                HorizontalContentAlignment="Left" Padding="14,0" Style="{StaticResource GlassButton}"
                                Click="OnNavLayoutClicked"/>
                        <Button x:Name="NavRecovery" Content="Explorer Recovery" Height="38" Margin="0,0,0,6"
                                HorizontalContentAlignment="Left" Padding="14,0" Style="{StaticResource GlassButton}"
                                Click="OnNavRecoveryClicked"/>
                        <Button x:Name="NavAbout" Content="About" Height="38" Margin="0,0,0,6"
                                HorizontalContentAlignment="Left" Padding="14,0" Style="{StaticResource GlassButton}"
                                Click="OnNavAboutClicked"/>
                    </StackPanel>

                    <!-- Version indicator at bottom -->
                    <TextBlock Grid.Row="2" Text="v0.5.0" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Right: Content Area -->
            <Grid Grid.Column="1" Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header + Window Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="TxtPageTitle" Text="General Settings" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource FontDisplay}"/>
                    <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right"
                            Style="{StaticResource GlassIconButton}" Click="OnBtnCloseClicked"/>
                </Grid>

                <!-- Pages Container -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PAGE 1: GENERAL -->
                        <StackPanel x:Name="PageGeneral" Visibility="Visible">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Startup &amp; Behavior" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkStartWithWindows" Content="Start GlassFolders when Windows starts (system tray)"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"
                                               Checked="OnStartupCheckChanged" Unchecked="OnStartupCheckChanged"/>
                                    <CheckBox x:Name="ChkCheckMissing" Content="Show warning badge on shortcuts with missing targets"
                                               Foreground="{StaticResource BrushTextSecondary}" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Grid &amp; Desktop Snapping" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkSnapToGrid" Content="Snap folders to grid when dragging"
                                               Foreground="{StaticResource BrushTextSecondary}" IsChecked="True" Margin="0,0,0,12"/>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="Grid Cell Size (px):" Foreground="{StaticResource BrushTextSecondary}" Width="140" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtGridVal" Text="20" Foreground="{StaticResource BrushAccent}" Width="30" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderGrid" Minimum="10" Maximum="60" Value="20" TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="OnGridSliderChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 2: APPEARANCE -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Liquid Glass Effects" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkAcrylicBlur" Content="Enable DWM Acrylic background blur"
                                               Foreground="{StaticResource BrushTextSecondary}" IsChecked="True" Margin="0,0,0,10"/>
                                    <TextBlock Text="Uses GPU hardware composition to blur your desktop wallpaper behind popups."
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="24,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Popup Layout" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                        <TextBlock Text="Grid Columns:" Foreground="{StaticResource BrushTextSecondary}" Width="140" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtColumnsVal" Text="4" Foreground="{StaticResource BrushAccent}" Width="30" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderColumns" Minimum="3" Maximum="6" Value="4" IsSnapToTickEnabled="True"
                                                ValueChanged="OnColumnsSliderChanged"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="Grid Rows:" Foreground="{StaticResource BrushTextSecondary}" Width="140" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRowsVal" Text="3" Foreground="{StaticResource BrushAccent}" Width="30" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderRows" Minimum="2" Maximum="5" Value="3" IsSnapToTickEnabled="True"
                                                ValueChanged="OnRowsSliderChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 3: DESKTOP LAYOUT -->
                        <StackPanel x:Name="PageLayout" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Connected Displays (Multi-Monitor)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="GlassFolders pins folders relative to their home display. If a display is disconnected, folders temporarily displace to the primary display without losing their home layout."
                                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <ItemsControl x:Name="MonitorsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="🖥️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"/>
                                                            <TextBlock Text="{Binding WorkArea, StringFormat='Work Area: {0}'}" FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                        <TextBlock Text="Desktop Folders" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <Button Content="+ New Folder" DockPanel.Dock="Right" Style="{StaticResource GlassButton}"
                                                Click="OnBtnNewFolderClicked"/>
                                    </DockPanel>

                                    <!-- Folders List -->
                                    <ItemsControl x:Name="FoldersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Items.Count, StringFormat='({0} items)'}" Foreground="#80FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 4: EXPLORER RECOVERY -->
                        <StackPanel x:Name="PageRecovery" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Explorer Shell Integration &amp; Recovery" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                    <TextBlock Text="GlassFolders continuously monitors Explorer for crashes, restarts, and power events. It automatically reattaches desktop folder windows with idempotent backoff."
                                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State:" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="6" Padding="8,2"
                                                x:Name="BadgeRecoveryState" Background="#2235D07F">
                                            <TextBlock x:Name="TxtRecoveryState" Text="Healthy" FontWeight="SemiBold" Foreground="#35D07F" FontSize="12"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Event:" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRecoveryLastEvent" Text="Initialized" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Reattach Count:" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtReattachCount" Text="0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Button x:Name="BtnRecoverNow" Content="Recover Now (Force Reattach)" Style="{StaticResource GlassButton}"
                                            HorizontalAlignment="Left" Padding="16,8" Margin="0,6,0,0" Click="OnBtnRecoverNowClicked"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics &amp; Logs" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Rolling diagnostic logs (up to 5 × 1 MB) are saved in your local app data."
                                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <DockPanel LastChildFill="False">
                                        <Button Content="Open Logs Folder" Style="{StaticResource GlassButton}"
                                                Padding="14,6" Click="OnBtnOpenLogsClicked"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PAGE 5: ABOUT -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="GlassFolders" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Version 0.5.0 · Phase 5 Multi-Monitor" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,2,0,12"/>
                                    <TextBlock Text="Phone-style app folders on your real Windows 11 desktop, with a Liquid Glass popup."
                                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <TextBlock Text="Architecture: .NET 10 (LTS) WPF · Win32 DWM Acrylic · Per-Monitor-V2 DPI · Multi-Monitor Support"
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Developed with pair-programming on Windows 11 25H2."
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,16"/>
                                    <TextBlock Text="Copyright © 2026 Riekie3. Released under the MIT License."
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
