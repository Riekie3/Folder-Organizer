<ui:GlassWindow x:Class="GlassFolders.App.UI.GlassPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GlassFolders.App.UI"
        SizeToContent="WidthAndHeight" Title="Rename">

    <ui:GlassCard x:Name="Card" Margin="40" Width="440">
        <StackPanel Margin="28,26,28,24">
            <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource FontDisplay}"
                       Foreground="{DynamicResource ChromeText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtLabel" Style="{StaticResource HintText}" Margin="0,6,0,0" Visibility="Collapsed"/>
            <TextBox x:Name="TxtValue" Margin="0,16,0,0" FontSize="14" MinHeight="40" MaxLength="80"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Style="{StaticResource GlassButton}" MinWidth="88" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClicked"/>
                <Button x:Name="BtnOk" Content="Save" Style="{StaticResource AccentButton}" MinWidth="88" IsDefault="True" Click="OnOkClicked"/>
            </StackPanel>
        </StackPanel>
    </ui:GlassCard>
</ui:GlassWindow>
