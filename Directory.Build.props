<Project>
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Product>GlassFolders</Product>
    <Company>Rie-Sources</Company>
    <Authors>Rie-Sources</Authors>
    <Copyright>Copyright © 2026 Rie-Sources (https://rie-sources.com/)</Copyright>
    <PackageProjectUrl>https://rie-sources.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Riekie3/Folder-Organizer</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
